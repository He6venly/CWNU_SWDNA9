# 필요한 공개 환경변수만 VITE_ 접두사로 추가
# VITE_ 변수는 브라우저에 공개되므로 API 비밀키·인증정보 저장 금지

# 서버 전용. 다른 프론트 개발 서버의 정확한 Origin을 쉼표로 구분
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
USE_DEMO_RECOGNITION=true

# 실제 호출 잠금. 키만 등록해도 호출되지 않음
GEMINI_CALLS_ENABLED=false
# 수동 실호출 단계에서만 USE_DEMO_RECOGNITION=false 및 위 스위치를 true로 변경
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_LOOKUP_MODEL=  # 생략 시 GEMINI_MODEL. Google Search + 구조화 출력을 지원하는 모델 필요
