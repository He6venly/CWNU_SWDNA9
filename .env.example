# 필요한 공개 환경변수만 VITE_ 접두사로 추가
# VITE_ 변수는 브라우저에 공개되므로 API 비밀키·인증정보 저장 금지

# 서버 전용. 다른 프론트 개발 서버의 정확한 Origin을 쉼표로 구분
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
USE_DEMO_RECOGNITION=false

# 실제 Gemini 사진 인식 호출. 비밀키는 서버 환경변수에만 등록
GEMINI_CALLS_ENABLED=true
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tavily는 제품 웹 검색과 정확한 모델 출처 확인에 사용
# TAVILY_API_KEY=
